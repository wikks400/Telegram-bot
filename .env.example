# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example

# Authorized Telegram user IDs (comma-separated, e.g. 12345678,98765432)
# To find your ID, message @userinfobot on Telegram
TELEGRAM_ADMIN_IDS=123456789

# OpenSea API v2 Key (Get one from https://docs.opensea.io)
OPENSEA_API_KEY=your_opensea_api_key_here

# Persistent SQLite database file path (e.g. on Botkeep persistent volume)
DATABASE_PATH=./data/nft_bot.sqlite

# Polling interval in seconds (default: 30)
POLL_INTERVAL_SECONDS=30

# Optional Server Port for the web dashboard & API
PORT=3000
